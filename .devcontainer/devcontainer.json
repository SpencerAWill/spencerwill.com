{
  "name": "spencerwill.com",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",

  "features": {
    // Official way to put the account on zsh. The base image ships oh-my-zsh
    // but leaves the user on /bin/bash, and VS Code only papers over that with
    // a terminal-profile setting that Zed does not read. installOhMyZshConfig
    // is off because features run after the Dockerfile, and its template would
    // overwrite the theme and plugin list set there. upgradePackages is off to
    // keep builds reproducible and quick.
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "dev",
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "installOhMyZshConfig": false,
      "upgradePackages": false
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    // Pulumi CLI for infra/. A thin wrapper around Pulumi's own installer.
    // Left on "latest": the CLI is a client for a hosted service and the two
    // are expected to track each other, and state formats are
    // backward-compatible. Log in with `pulumi login` or PULUMI_ACCESS_TOKEN.
    "ghcr.io/devcontainers-extra/features/pulumi:1": {}
  },

  "containerEnv": {
    "TZ": "${localEnv:TZ:America/New_York}"
  },

  // Host-side hook, before the container exists. See the script for why it is
  // not inlined here.
  "initializeCommand": [".devcontainer/initialize.sh"],

  // Every in-container hook routes through lifecycle.sh so the ordering and the
  // reason each step lives at its stage stay readable in one file.
  //
  // Array form, not strings, because of a Zed bug (zed-industries/zed#62964):
  // Zed wraps a string command as `/bin/sh -c <script>` and then joins that
  // array with spaces into another `sh -c`, so the stage argument lands in $0
  // and lifecycle.sh sees no $1. Keep arguments free of spaces: Zed's join
  // does no quoting.
  "onCreateCommand": [".devcontainer/lifecycle.sh", "on-create"],
  "updateContentCommand": [".devcontainer/lifecycle.sh", "update-content"],
  "postCreateCommand": [".devcontainer/lifecycle.sh", "post-create"],
  "postStartCommand": [".devcontainer/lifecycle.sh", "post-start"],
  "postAttachCommand": [".devcontainer/lifecycle.sh", "post-attach"],

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "biomejs.biome",
        "editorconfig.editorconfig",
        "yoavbls.pretty-ts-errors",
        "usernamehw.errorlens",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "pulumi.pulumi-vscode-tools",
        "redhat.vscode-yaml",
        "vivaxy.vscode-conventional-commits"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          "source.organizeImports.biome": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        // /workspace is a slow bind mount, and watching node_modules turns
        // every install into a file-event storm.
        "files.watcherExclude": {
          "**/node_modules/**": true
        }
      }
    }
  }
}
